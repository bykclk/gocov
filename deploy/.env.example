# Configuration for docker-compose.prod.yml. Copy to .env (gitignored)
# next to it and fill in the four required values; everything else is
# optional. The server's own reference for these is docs/configuration.md.

# --- required ------------------------------------------------------------

# The release to run. Pin an exact tag; upgrading is changing this and
# `docker compose -f docker-compose.prod.yml pull && ... up -d`.
# x-release-please-start-version
GOCOV_VERSION=v0.23.0
# x-release-please-end

# Public hostname. Caddy serves it on 443 and fetches the certificate for
# it, so its DNS must already point here and 80/443 must be reachable.
GOCOV_HOST=gocov.example.com

# Public URL, https://GOCOV_HOST. Every link gocov hands out — statuses,
# PR comments, badges — is built from this, and cookies are Secure only
# when it starts with https://.
GOCOV_BASE_URL=https://gocov.example.com

# 64 hex characters of AES key material: `openssl rand -hex 32`. Encrypts
# Bitbucket and GitLab refresh tokens at rest. Back it up outside the
# database dump.
GOCOV_SECRET_KEY=

# --- database ------------------------------------------------------------

# Bring your own Postgres and put its DSN here (sslmode and friends go in
# the URL) ...
DATABASE_URL=

# ... or run the bundled one: uncomment these three lines and leave the
# DATABASE_URL above empty. The password is only ever used inside the
# compose network; the port is not published.
#COMPOSE_PROFILES=db
#POSTGRES_PASSWORD=change-me
#DATABASE_URL=postgres://gocov:change-me@db:5432/gocov

# --- sign-in and forge connections (docs/sign-in.md, docs/forge-connections.md)

# private: only members of tracked workspaces may sign in (default).
# hosted: any forge account may sign in and register workspaces.
#GOCOV_MODE=private

# OAuth apps for web sign-in. Setting a pair turns that forge's sign-in on.
#GOCOV_OAUTH_GITHUB_KEY=
#GOCOV_OAUTH_GITHUB_SECRET=
#GOCOV_OAUTH_GITLAB_KEY=
#GOCOV_OAUTH_GITLAB_SECRET=
#GOCOV_OAUTH_BITBUCKET_KEY=
#GOCOV_OAUTH_BITBUCKET_SECRET=

# GitHub App for check runs, PR comments and statuses on GitHub. The key
# is a PEM file on this host, mounted into the container read-only; keep
# it mode 600 and owned by uid 65532 (docs/self-hosting.md).
#GOCOV_GITHUB_APP_ID=
#GOCOV_GITHUB_APP_KEY_FILE=./github-app.pem
#GOCOV_GITHUB_WEBHOOK_SECRET=

# Self-managed GitLab: its base URL, so its OIDC tokens are trusted for
# tokenless uploads (replaces the gitlab.com default).
#GOCOV_OIDC_ISSUERS=
